{
  "name": "vivasim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first browser-based viva practice MVP",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/prepare.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "next": "16.4.5",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
