# Optional server-side OpenAI-compatible provider. Never use NEXT_PUBLIC_ for keys.
VIVASIM_AI_KEY=
VIVASIM_AI_URL=https://api.openai.com/v1/chat/completions
VIVASIM_AI_MODEL=gpt-4o-mini
# Optional second OpenAI-compatible provider (for example Groq).
VIVASIM_FALLBACK_KEY=
VIVASIM_FALLBACK_URL=https://api.groq.com/openai/v1/chat/completions
VIVASIM_FALLBACK_MODEL=llama-3.3-70b-versatile
