# Optional server-side OpenAI-compatible provider. Never use NEXT_PUBLIC_ for keys.
VIVASIM_AI_KEY=
VIVASIM_AI_URL=https://api.openai.com/v1/chat/completions
VIVASIM_AI_MODEL=gpt-4o-mini
# Optional second OpenAI-compatible provider (for example Groq).
VIVASIM_FALLBACK_KEY=
VIVASIM_FALLBACK_URL=https://api.groq.com/openai/v1/chat/completions
VIVASIM_FALLBACK_MODEL=llama-3.3-70b-versatile
# Required before production AI calls. Upstash-compatible Redis REST endpoint.
# Provision outside this repository; never use NEXT_PUBLIC_ for these credentials.
VIVASIM_BUDGET_REDIS_URL=
VIVASIM_BUDGET_REDIS_TOKEN=
# Global provider attempts per UTC day, including retries/fallbacks. Not a dollar cap.
VIVASIM_AI_DAILY_ATTEMPTS=100

# Multi-provider chat: choose models and verify CURRENT free-tier terms before enabling.
# No model defaults or paid auto-fallback. Never use client-side keys.
VIVASIM_CHAT_GROQ_KEY=
VIVASIM_CHAT_GROQ_MODEL=
VIVASIM_CHAT_GROQ_FREE_TIER_CONFIRMED=false
VIVASIM_CHAT_GEMINI_KEY=
VIVASIM_CHAT_GEMINI_MODEL=
VIVASIM_CHAT_GEMINI_FREE_TIER_CONFIRMED=false
VIVASIM_CHAT_CEREBRAS_KEY=
VIVASIM_CHAT_CEREBRAS_MODEL=
VIVASIM_CHAT_CEREBRAS_FREE_TIER_CONFIRMED=false
VIVASIM_CHAT_OPENROUTER_KEY=
VIVASIM_CHAT_OPENROUTER_MODEL=
VIVASIM_CHAT_OPENROUTER_FREE_TIER_CONFIRMED=false
VIVASIM_CHAT_HUGGINGFACE_KEY=
VIVASIM_CHAT_HUGGINGFACE_MODEL=
VIVASIM_CHAT_HUGGINGFACE_FREE_TIER_CONFIRMED=false

# OpenRouter models must end in :free. Other free-tier terms require operator verification.
